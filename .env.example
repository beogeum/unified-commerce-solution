# 개발용 예시. 실제 키·비밀번호를 커밋하지 말 것(docs/16).
DB_URL=jdbc:postgresql://localhost:5432/commerce_os
DB_USER=commerce_os
DB_PASSWORD=commerce_os
# 32바이트 키를 base64 로: head -c32 /dev/urandom | base64
CRYPTO_ACTIVE_KEY_ID=k1
CRYPTO_KEY_K1=
CRYPTO_HMAC_KEY=
FILES_ROOT=./data/files
MOCK_CONNECTORS_ENABLED=true
BOOTSTRAP_ENABLED=true
BOOTSTRAP_WORKSPACE_CODE=demo
BOOTSTRAP_OWNER_EMAIL=admin@example.com
BOOTSTRAP_OWNER_PASSWORD=
